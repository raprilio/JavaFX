{
  "manifest_version": 2,
  "name": "Form Auto Fill",
  "version": "1.0.0",
  "description": "Isi otomatis field form (termasuk dropdown pencarian) di satu website dengan nilai yang kamu tetapkan.",
  "browser_specific_settings": {
    "gecko": {
      "id": "form-autofill@local.torii",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["storage", "activeTab", "tabs", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Form Auto Fill",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
